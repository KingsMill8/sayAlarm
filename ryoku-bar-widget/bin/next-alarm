#!/usr/bin/env python3
"""Print the next SayAlarm as one JSON line for the Ryoku bar widget.

Reads ~/.local/share/sayalarm/alarms.json (via the app's own alarm_lib)
and prints either:
  {"time": "07:30", "note": "Gym", "when": "in 3h 12m"}
or:
  {"none": true}
Always exits 0; prints {"none": true} on any failure so the widget
keeps its last good values.
"""
import json
import os
import sys


def find_app_dir() -> str | None:
    """Locate the SayAlarm app checkout on any machine."""
    candidates = []
    env = os.environ.get("SAYALARM_DIR")
    if env:
        candidates.append(env)
    home = os.path.expanduser("~")
    candidates += [
        os.path.join(home, "Projects", "sayalarm"),
        os.path.join(home, "sayalarm"),
        os.path.join(home, "sayAlarm"),
        os.path.join(home, "Projects", "sayAlarm"),
    ]
    for cand in candidates:
        if os.path.isfile(os.path.join(cand, "sayalarm.py")) and \
                os.path.isfile(os.path.join(cand, "alarm_lib.py")):
            return cand
    return None


APP_DIR = find_app_dir()
if APP_DIR:
    sys.path.insert(0, APP_DIR)

from datetime import datetime


def main() -> None:
    try:
        import alarm_lib as lib
    except ImportError:
        print(json.dumps({"none": True}))
        return
    try:
        now = datetime.now()
        best = None
        for alarm in lib.load_alarms():
            ahead = lib.next_fire_in_minutes(alarm, now)
            if ahead is None:
                continue
            if best is None or ahead < best[0]:
                best = (ahead, alarm)
        if best is None:
            print(json.dumps({"none": True}))
            return
        ahead, alarm = best
        print(json.dumps({
            "time": f"{alarm['hour']:02d}:{alarm['min']:02d}",
            "note": (alarm.get("note") or "Alarm").strip(),
            "when": lib.fmt_countdown(ahead),
        }))
    except Exception:
        print(json.dumps({"none": True}))


main()
